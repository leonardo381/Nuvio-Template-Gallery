# cms5 public runtime env template
# IMPORTANT: Any VITE_* variable is exposed to the browser bundle.

# Public/browser-exposed variables (safe to expose)
VITE_PB_URL=https://your-backend.example.com
VITE_NUVIO_BACKEND_URL=https://your-backend.example.com
# Preview parent origin(s) allowed to frame the public runtime in production.
# Use exact origin(s), separated by spaces or commas.
# Dev example: http://localhost:3000
# Prod example: https://admin.your-domain.example.com
VITE_CMS_PREVIEW_PARENT_ORIGIN=
VITE_PUBLIC_SITE_BASE_URL=https://www.your-site.example.com

# Server-only fallbacks used by server routes/helpers
NUVIO_BACKEND_URL=
PB_URL=
